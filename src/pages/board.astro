---
import Layout from '../layouts/Layout.astro';
import Board from '../components/Board';
import { ladeBoard } from '../lib/board';
const start = await ladeBoard(Astro.locals.mitglied!);
---
<Layout titel="Board">
  <main class="inhalt">
    <Board client:load start={start} />
  </main>
</Layout>

<style is:global>
  .board-seite { display: grid; gap: 1rem; }
  .toast { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); z-index: 100; max-width: min(560px, 92vw);
    background: var(--sumi); color: var(--washi-hell); padding: 0.8rem 1.1rem; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.25); cursor: pointer; }
  .aushang { display: grid; gap: 0.6rem; padding: 0.8rem 1rem; border: 1.5px dashed var(--holz); border-radius: 12px; background: rgba(248, 249, 243, 0.7); }
  .aushang p { margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .antrag { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; justify-content: space-between; }
  .antrag-knoepfe { display: flex; gap: 0.5rem; }

  .werkzeuge { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .werkzeuge input[type=search] { width: auto; flex: 1 1 180px; min-width: 140px; }
  .werkzeuge select { width: auto; flex: 0 1 auto; }

  .spalten { display: grid; grid-template-columns: repeat(5, minmax(240px, 1fr)); gap: 1rem; align-items: start; }
  .spalten-reiter { display: none; }
  .spalte { background: rgba(248, 249, 243, 0.55); border: 1px solid var(--linie); border-top: 0; border-radius: 0 0 14px 14px; min-height: 240px; transition: background 120ms; }
  .spalte.drueber { background: rgba(62, 125, 74, 0.1); }
  .spalte-kopf { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.7rem 0.9rem; margin: 0 -6px;
    background: linear-gradient(var(--holz), #6d5235); color: #fbf6ea; border-radius: 8px; box-shadow: 0 2px 0 rgba(0,0,0,0.15); }
  .spalte-kopf h2 { font-size: 1.05rem; font-weight: 800; }
  .spalte[data-spalte=erledigt] .spalte-kopf { background: linear-gradient(var(--moos), #1e3a26); }
  .anzahl { font-weight: 700; font-size: 0.85rem; min-width: 1.8em; text-align: center; padding: 0 0.4em; border-radius: 999px; background: rgba(255,255,255,0.18); }
  .spalte-inhalt { display: grid; gap: 0.6rem; padding: 0.75rem; }
  .spalte-leer { margin: 0.25rem 0.25rem 0.5rem; color: var(--sumi-leise); font-size: 0.9rem; }

  .karte { position: relative; display: grid; gap: 0.45rem; padding: 0.7rem 0.8rem 0.65rem 0.85rem; background: var(--washi-hell); border: 1px solid var(--linie);
    border-left: 5px solid var(--linie); border-radius: 8px; cursor: grab; touch-action: manipulation; text-align: left; }
  .karte:hover { border-color: #b9c0ad; }
  .karte.zieht { cursor: grabbing; z-index: 50; box-shadow: 0 12px 28px rgba(31,42,36,0.25); transform-origin: center; }
  .karte.blockiert { background: repeating-linear-gradient(-45deg, var(--washi-hell) 0 10px, #f1ede4 10px 20px); }
  .karte.erledigt h3 { color: var(--sumi-leise); }
  .karte h3 { font-family: var(--schrift-text); font-weight: 700; font-size: 1rem; line-height: 1.35; }
  .karte-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.78rem; color: var(--sumi-leise); }
  .karte-meta .projekt { color: var(--moos); font-weight: 700; }
  .karte-marken { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .marke { font-size: 0.75rem; font-weight: 700; padding: 0.05em 0.5em; border-radius: 999px; background: #e7eadf; color: var(--sumi-leise); }
  .marke.hoch { background: #2a4f33; color: #f8f9f3; }
  .marke.blockiert { background: #efe3c9; color: #6d5235; }
  .marke.frist.bald { background: #f3e6c4; color: #6b4d12; }
  .marke.frist.ueber { background: #f6e4e1; color: #7a1f19; }
  .karte-fuss { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.5rem; }
  .siegel-reihe { display: flex; flex-wrap: wrap; gap: 0.35rem 0.45rem; }
  .siegel-reihe .frei { font-size: 0.8rem; color: var(--holz); font-style: italic; }
  .siegel-reihe.gross .siegel { font-size: 1rem; }
  .kommentar-zahl { font-size: 0.8rem; color: var(--sumi-leise); white-space: nowrap; }

  .dialog { width: min(720px, 96vw); max-height: 92dvh; padding: 0; border: 0; border-radius: 16px; background: var(--washi-hell); color: var(--sumi); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  .dialog.klein { width: min(520px, 96vw); }
  .dialog::backdrop { background: rgba(31, 42, 36, 0.45); }
  .dialog-inhalt { display: grid; gap: 1rem; padding: 1.25rem clamp(1rem, 4vw, 1.75rem) 1.5rem; }
  .dialog-inhalt h2 { font-size: 1.6rem; color: var(--moos); }
  .dialog-inhalt h3 { font-size: 1.05rem; }
  .dialog-inhalt .leise { color: var(--sumi-leise); margin: 0; }
  .dialog-knoepfe, .knopf-reihe { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: flex-end; }
  .knopf-reihe { justify-content: flex-start; }
  .knopf-reihe.ende { justify-content: flex-end; border-top: 1px solid var(--linie); padding-top: 1rem; }
  .zwei { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .haken { display: flex; gap: 0.6rem; align-items: center; font-weight: 700; }
  .haken input { width: 20px; height: 20px; accent-color: var(--moos); }
  .detail-kopf { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .schliessen { border: 0; background: none; font-size: 2rem; line-height: 1; padding: 0 0.25rem; color: var(--sumi-leise); }
  .detail-block { display: grid; gap: 0.7rem; padding-top: 1rem; border-top: 1px solid var(--linie); }
  .beschreibung { margin: 0; white-space: pre-wrap; line-height: 1.6; max-width: 70ch; }
  .eckdaten { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.5rem 1rem; margin: 0; }
  .eckdaten dt { font-size: 0.8rem; color: var(--sumi-leise); font-weight: 700; }
  .eckdaten dd { margin: 0; }
  .bearbeiten { display: grid; gap: 0.8rem; }
  .detail-block > .knopf { justify-self: start; }
  .siegel-knopf { background: var(--hanko); border-color: var(--hanko); justify-self: start; }
  .siegel-knopf:hover { background: #8f241e; border-color: #8f241e; }
  .links, .kommentare { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .links li { display: flex; gap: 0.75rem; align-items: baseline; flex-wrap: wrap; }
  .kommentare li { padding: 0.6rem 0.75rem; background: #f1f3ea; border-radius: 10px; }
  .kommentare p { margin: 0.2rem 0 0; white-space: pre-wrap; }
  .kommentar-kopf { display: flex; gap: 0.5rem; align-items: baseline; flex-wrap: wrap; }
  .link-form, .kommentar-form { display: grid; gap: 0.5rem; }
  .link-form { grid-template-columns: 2fr 1.4fr auto; }
  .kommentar-form textarea { min-height: 4em; }
  .kommentar-form .knopf { justify-self: start; }
  .text-knopf { background: none; border: 0; color: var(--sumi-leise); text-decoration: underline; padding: 0; font-size: 0.85rem; }
  .verlauf summary { cursor: pointer; font-weight: 700; }
  .verlauf ol { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .spalten-reiter { display: flex; gap: 0.35rem; overflow-x: auto; padding-bottom: 0.25rem; scrollbar-width: none; }
    .spalten-reiter button { flex: 0 0 auto; min-height: 40px; padding: 0 0.9em; border-radius: 999px; border: 1.5px solid var(--linie); background: var(--washi-hell); font-weight: 700; color: var(--sumi-leise); }
    .spalten-reiter button[aria-pressed=true] { background: var(--holz); border-color: var(--holz); color: #fbf6ea; }
    .spalten-reiter span { opacity: 0.75; margin-left: 0.2em; }
    .spalten { grid-template-columns: 1fr; }
    .spalte { display: none; }
    .spalte.aktiv { display: block; }
    .werkzeuge select { flex: 1 1 45%; }
    .zwei, .link-form { grid-template-columns: 1fr; }
    .dialog { width: 100vw; max-width: 100vw; max-height: 94dvh; margin: auto 0 0; border-radius: 18px 18px 0 0; }
  }
</style>
