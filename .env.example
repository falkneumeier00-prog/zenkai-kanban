# Postgres-Verbindung (lokal oder Neon, bei Neon die "pooled" Verbindung nehmen)
DATABASE_URL=postgres://postgres@localhost:5432/diplomatie

# Hash des Gruppenpassworts. Erzeugen mit:  npm run hash-passwort -- "euer-passwort"
TOR_PASSWORT_HASH=

# Langer Zufallswert zum Signieren der Anmelde-Cookies. Erzeugen mit:  openssl rand -base64 48
SESSION_SECRET=

# Wer Rücksetzanträge für Mudra-Folgen genehmigen darf (RP-Namen, kommagetrennt)
RUECKSETZ_GENEHMIGER=Hinabi Kazan,Rei Hyuga
